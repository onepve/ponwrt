# 硬件与机型锁定：达发 AN7581 / 兆能 ZN504XG-D
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d=y

# 核心网络吞吐与硬件加速 (PPE Offload)
CONFIG_PACKAGE_kmod-nft-offload=y

# 电信 4K IPTV 单播与组播支持
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y

# 局域网服务与便捷工具
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# 现代高颜值 Argon 主题
CONFIG_PACKAGE_luci-theme-argon=y
